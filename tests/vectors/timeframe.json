{
  "suite": "timeframe",
  "spec": "engines/TIMEFRAME_ENGINE.md",
  "note": "The worked example from TIMEFRAME_ENGINE.md section 5, cell by cell, plus class boundaries. Pattern timeframe list is H1/H4/D1 = '60,240,1440' unless stated.",
  "class_cases": [
    {"minutes": 0.25, "expect": "SUB_MINUTE", "desc": "15-second chart"},
    {"minutes": 1, "expect": "MIN_FAST"},
    {"minutes": 3, "expect": "MIN_FAST"},
    {"minutes": 4, "expect": "MIN_FAST", "desc": "upper boundary of MIN_FAST"},
    {"minutes": 5, "expect": "MIN_MID", "desc": "lower boundary of MIN_MID"},
    {"minutes": 7, "expect": "MIN_MID", "desc": "non-canonical timeframe still classified"},
    {"minutes": 10, "expect": "MIN_MID"},
    {"minutes": 14, "expect": "MIN_MID"},
    {"minutes": 15, "expect": "MIN_SLOW"},
    {"minutes": 30, "expect": "MIN_SLOW"},
    {"minutes": 45, "expect": "MIN_SLOW"},
    {"minutes": 59, "expect": "MIN_SLOW"},
    {"minutes": 60, "expect": "HOUR_LOW"},
    {"minutes": 120, "expect": "HOUR_LOW"},
    {"minutes": 180, "expect": "HOUR_LOW"},
    {"minutes": 239, "expect": "HOUR_LOW"},
    {"minutes": 240, "expect": "HOUR_HIGH"},
    {"minutes": 360, "expect": "HOUR_HIGH"},
    {"minutes": 540, "expect": "HOUR_HIGH", "desc": "9H, non-canonical"},
    {"minutes": 720, "expect": "HOUR_HIGH"},
    {"minutes": 1439, "expect": "HOUR_HIGH"},
    {"minutes": 1440, "expect": "DAILY"},
    {"minutes": 2880, "expect": "DAILY", "desc": "2D"},
    {"minutes": 4320, "expect": "DAILY", "desc": "3D stays daily, not weekly"},
    {"minutes": 10079, "expect": "DAILY"},
    {"minutes": 10080, "expect": "WEEKLY", "desc": "1W"},
    {"minutes": 20160, "expect": "WEEKLY", "desc": "2W"},
    {"minutes": 43199, "expect": "WEEKLY"},
    {"minutes": 43200, "expect": "MONTHLY", "desc": "1M"},
    {"minutes": 129600, "expect": "MONTHLY", "desc": "3M"}
  ],
  "allow_cases": [
    {"minutes": 1, "tfs": "60,240,1440", "exact": false, "class": false, "desc": "1m: hidden in both"},
    {"minutes": 5, "tfs": "60,240,1440", "exact": false, "class": false},
    {"minutes": 15, "tfs": "60,240,1440", "exact": false, "class": false},
    {"minutes": 45, "tfs": "60,240,1440", "exact": false, "class": false, "desc": "45m is MIN_SLOW; nothing listed is in that class"},
    {"minutes": 60, "tfs": "60,240,1440", "exact": true, "class": true, "desc": "listed"},
    {"minutes": 120, "tfs": "60,240,1440", "exact": false, "class": true, "desc": "2H shares HOUR_LOW with the listed 1H"},
    {"minutes": 180, "tfs": "60,240,1440", "exact": false, "class": true},
    {"minutes": 240, "tfs": "60,240,1440", "exact": true, "class": true, "desc": "listed"},
    {"minutes": 360, "tfs": "60,240,1440", "exact": false, "class": true},
    {"minutes": 720, "tfs": "60,240,1440", "exact": false, "class": true},
    {"minutes": 1440, "tfs": "60,240,1440", "exact": true, "class": true, "desc": "listed"},
    {"minutes": 2880, "tfs": "60,240,1440", "exact": false, "class": true},
    {"minutes": 10080, "tfs": "60,240,1440", "exact": false, "class": false, "desc": "weekly: no listed timeframe is weekly"},
    {"minutes": 43200, "tfs": "60,240,1440", "exact": false, "class": false},
    {"minutes": 0.5, "tfs": "60,240,1440", "exact": false, "class": false, "desc": "sub-minute charts show nothing when enforced"},
    {"minutes": 5, "tfs": "5,15,30", "exact": true, "class": true, "desc": "a fast-timeframe pattern on its own timeframe"},
    {"minutes": 10, "tfs": "5,15,30", "exact": false, "class": true, "desc": "10m shares MIN_MID with the listed 5m"},
    {"minutes": 1440, "tfs": "5,15,30", "exact": false, "class": false, "desc": "a fast pattern is hidden on daily"}
  ],
  "override_cases": [
    {"minutes": 5, "tfs": "60,240,1440", "mode": "OFF", "test_mode": false, "expect": true},
    {"minutes": 5, "tfs": "60,240,1440", "mode": "EXACT", "test_mode": true, "expect": true, "desc": "TEST MODE overrides EXACT"},
    {"minutes": 5, "tfs": "60,240,1440", "mode": "CLASS", "test_mode": true, "expect": true},
    {"minutes": 5, "tfs": "", "mode": "EXACT", "test_mode": false, "expect": true, "desc": "an unsupplied timeframe list must not silently hide a pattern everywhere"}
  ]
}
