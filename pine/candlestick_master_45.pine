addPat("TS3", "Tri-Star (Bullish)", 42, 3, 1, 3, 68, "|D1|W1|", "Reversal", 3,
      "Three consecutive dojis with the middle one separating below the other two — a three-act equilibrium at the bottom of a move. Extremely rare and, at the right location, extremely telling.",
      "Prior downtrend. Three consecutive dojis; the middle doji's body sits below both neighbours' bodies.",
      "Below the lowest low of the three dojis.",
      "The first meaningful resistance level.",
      "On spot forex a true tri-star almost never prints with real gaps — run it in 'Body gap' mode and expect it on D1/W1 only.")
addPat("ADB", "Advance Block", 43, 3, -1, 2, 61, "|H4|D1|", "Exhaustion", 3,
      "Three soldiers losing step: three green candles with shrinking bodies and lengthening upper shadows. The advance is still going but every candle is meeting more supply than the last.",
      "Prior uptrend. Three bullish candles with rising closes, each body smaller than the previous, and upper shadows growing (candle 3's upper shadow at least half its body).",
      "Above the highest high of the three candles.",
      "Nearest support, then the swing low.",
      "This is a WARNING, not a short trigger — the professional use is to take partial profit on longs and only reverse after a bearish confirmation candle.")
addPat("DLB", "Deliberation Pattern", 44, 3, -1, 2, 60, "|H4|D1|", "Exhaustion", 3,
      "Three soldiers pausing to think: two strong green candles, then a third that shrinks into a small body / spinning top right at the highs. Buyers hesitated for the first time.",
      "Prior uptrend. Candles 1-2 long bullish with rising closes. Candle 3 a small body opening at or above candle 2's close and finishing near it.",
      "Above the pattern high.",
      "Nearest support, then the swing low.",
      "Close cousin of the Advance Block; the difference is that here the stall arrives all at once on candle 3 instead of gradually.")
addPat("UGC", "Upside Gap Two Crows", 45, 3, -1, 3, 59, "|D1|", "Exhaustion", 3,
      "Two black crows perched above a gap: a strong green candle, then a red candle separating above it, then a bigger red candle that swallows the first crow but still closes above the green candle's close. The euphoria is being eaten from the top down.",
      "Prior uptrend. Candle 1 a long bullish body. Candle 2 bearish, separated above candle 1's body. Candle 3 bearish, engulfing candle 2's body, but still closing above candle 1's close.",
      "Above the highest high of the pattern.",
      "Candle 1's close is the first target; a close below it turns this into a full reversal.",
      "The unfilled separation is the whole point — once price closes back below candle 1's close, stop treating this as exhaustion and start treating it as a trend change.")

// ── build the enabled mask once ────────────────────────────────────────────────────────
if barstate.isfirst and array.size(P_CODE) > 0
    string only = str.upper(str.replace_all(fOnly, " ", ""))
    string skip = str.upper(str.replace_all(fSkip, " ", ""))
    for i = 0 to array.size(P_CODE) - 1
        string code = array.get(P_CODE, i)
        int    cat  = array.get(P_CAT, i)
        int    prio = array.get(P_PRIO, i)
        int    rel  = array.get(P_REL, i)
        string role = array.get(P_ROLE, i)
        int    dist = tfDistance(array.get(P_TF, i))
        bool okTF   = tfMode == "Off — show on every time frame" ? true : tfMode == "Ideal ± 1 step" ? dist <= 1 : dist == 0
        bool okRole = fKind == "All" ? true : fKind == "Reversal only" ? role == "Reversal" : fKind == "Continuation only" ? role == "Continuation" : fKind == "Exhaustion only" ? role == "Exhaustion" : role == "Indecision"
        bool okCat  = cat == 1 ? fCat1 : cat == 2 ? fCat2 : fCat3
        bool okPrio = fPrio == "All" ? true : fPrio == "Must only" ? prio == 1 : prio <= 2
        bool okRel  = rel >= fRel
        bool okOnly = str.length(only) == 0 or str.contains("," + only + ",", "," + code + ",")
        bool okSkip = str.length(skip) == 0 or not str.contains("," + skip + ",", "," + code + ",")
        array.push(P_EN, okTF and okRole and okCat and okPrio and okRel and okOnly and okSkip)

// ═══════════════════════════════════════════════════════════════════════════════════════
//  CANDIDATE COLLECTOR
// ═══════════════════════════════════════════════════════════════════════════════════════
var array<int>   C_IDX = array.new<int>(0)
var array<float> C_HI  = array.new<float>(0)
var array<float> C_LO  = array.new<float>(0)
var array<int>   C_DIR = array.new<int>(0)
array.clear(C_IDX)
array.clear(C_HI)
array.clear(C_LO)
array.clear(C_DIR)

// idx = registry index (pattern number - 1); ok/phi/plo are read one bar back when the
// confirmation engine is on, so the label is judged by the candle that follows the pattern
// The direction filter is applied to the EMITTED direction, not the registry direction, so
// that a bearish Belt Hold stays hidden while "Bullish only" is selected.
f_check(int idx, bool ok, float phi, float plo, int dirOv) =>
    bool  okS = confirmOn ? ok[1] : ok
    float hiS = confirmOn ? phi[1] : phi
    float loS = confirmOn ? plo[1] : plo
    bool  okD = fDir == "All" ? true : fDir == "Bullish only" ? dirOv > 0 : fDir == "Bearish only" ? dirOv < 0 : dirOv == 0
    bool  en  = false
    if array.size(P_EN) > idx
        en := array.get(P_EN, idx)
    if okS and en and okD
        array.push(C_IDX, idx)
        array.push(C_HI, hiS)
        array.push(C_LO, loS)
        array.push(C_DIR, dirOv)

// ═══════════════════════════════════════════════════════════════════════════════════════
//  GAP / SEPARATION HELPERS  (forex rarely gaps — see the "Gap rule" input)
// ═══════════════════════════════════════════════════════════════════════════════════════
bool gOff  = gapMode == "Off (ignore gap rule)"
bool gWick = gapMode == "Strict (wick gap)"

bool sepDn_1v2 = gOff ? true : gWick ? high[1] < low[2] : bodyTop[1] < bodyBot[2]                                        // star below candle 1
bool sepUp_1v2 = gOff ? true : gWick ? low[1] > high[2] : bodyBot[1] > bodyTop[2]                                        // star above candle 1
bool sepTri    = gOff ? true : gWick ? high[1] < math.min(low[2], low[0]) : bodyTop[1] < math.min(bodyBot[2], bodyBot[0])// tri-star middle below
bool sepDn_3v4 = gOff ? true : gWick ? high[3] < low[4] : bodyTop[3] < bodyBot[4]                                        // breakaway candle 2
bool sepDn_1v2o = gOff ? true : gWick ? open[1] < low[2] : open[1] < bodyBot[2]                                          // baby swallow candle 3
bool sepUpOpen = gOff ? true : gWick ? open > high[1] : open > bodyTop[1]                                                // ladder bottom candle 5
// A kicker is defined by the violence of the open, so even in body mode it must clear the
// whole previous candle — otherwise every ordinary higher open would qualify as a kicker.
bool kickUp = gOff ? open >= bodyTop[1] : gWick ? open > high[1] : open >= high[1]
bool kickDn = gOff ? open <= bodyBot[1] : gWick ? open < low[1] : open <= low[1]

// ═══════════════════════════════════════════════════════════════════════════════════════
//  PATTERN DEFINITIONS
// ═══════════════════════════════════════════════════════════════════════════════════════
// ── 01–12 single candle ───────────────────────────────────────────────────────────────
bool p01 = tDn1 and notDoji and rng > 0 and dnWick >= body * hamWick and upWick <= rng * hamOpp and bodyBot >= low + rng * 0.5
bool p02 = tUp1 and notDoji and rng > 0 and dnWick >= body * hamWick and upWick <= rng * hamOpp and bodyBot >= low + rng * 0.5
bool p03 = tDn1 and notDoji and rng > 0 and upWick >= body * hamWick and dnWick <= rng * hamOpp and bodyTop <= high - rng * 0.5
bool p04 = tUp1 and notDoji and rng > 0 and upWick >= body * hamWick and dnWick <= rng * hamOpp and bodyTop <= high - rng * 0.5
bool p05 = isBull and isMaru and isLong
bool p06 = isBear and isMaru and isLong
bool p07 = isDoji and rng >= atr * 0.25 and not (dnWick >= rng * 0.6) and not (upWick >= rng * 0.6) and not (upWick >= rng * 0.3 and dnWick >= rng * 0.3)
bool p08 = isDoji and rng >= atr * 0.25 and dnWick >= rng * 0.6 and upWick <= rng * 0.15
bool p09 = isDoji and rng >= atr * 0.25 and upWick >= rng * 0.6 and dnWick <= rng * 0.15
bool p10 = isDoji and rng >= atr * 0.25 and upWick >= rng * 0.3 and dnWick >= rng * 0.3
bool p11 = notDoji and bodyPct <= 0.35 and upWick >= body and dnWick >= body and rng >= atr * 0.3
bool p12b = tDn1 and isBull and isLong and rng > 0 and dnWick <= rng * maruWick          // bullish belt hold
bool p12s = tUp1 and isBear and isLong and rng > 0 and upWick <= rng * maruWick          // bearish belt hold

// ── 13–25 double candle ───────────────────────────────────────────────────────────────
bool p13 = tDn2 and isBear[1] and isBull and close >= bodyTop[1] and open <= bodyBot[1] and body > body[1]
bool p14 = tUp2 and isBull[1] and isBear and open >= bodyTop[1] and close <= bodyBot[1] and body > body[1]
bool p15 = tDn2 and isBear[1] and isLong[1] and isBull and bodyTop <= bodyTop[1] and bodyBot >= bodyBot[1] and notDoji
bool p16 = tUp2 and isBull[1] and isLong[1] and isBear and bodyTop <= bodyTop[1] and bodyBot >= bodyBot[1] and notDoji
bool p17 = tDn2 and isBear[1] and isLong[1] and isDoji and bodyTop <= bodyTop[1] and bodyBot >= bodyBot[1]
bool p18 = tUp2 and isBull[1] and isLong[1] and isDoji and bodyTop <= bodyTop[1] and bodyBot >= bodyBot[1]
bool p19 = tDn2 and isBear[1] and isLong[1] and isBull and open < close[1] and close > (open[1] + close[1]) / 2 and close < open[1]
bool p20 = tUp2 and isBull[1] and isLong[1] and isBear and open > close[1] and close < (open[1] + close[1]) / 2 and close > open[1]
bool p21 = tDn2 and isBear[1] and isBull and math.abs(low - low[1]) <= atr * tweezTol and rng >= atr * 0.3
bool p22 = tUp2 and isBull[1] and isBear and math.abs(high - high[1]) <= atr * tweezTol and rng >= atr * 0.3
bool p23 = isBear[1] and isBull and kickUp and isLong
bool p24 = isBull[1] and isBear and kickDn and isLong
bool p25b = tUp2 and isBear[1] and isBull and math.abs(open - open[1]) <= atr * tweezTol and close > high[1] and isLong
bool p25s = tDn2 and isBull[1] and isBear and math.abs(open - open[1]) <= atr * tweezTol and close < low[1] and isLong

// ── 26–45 triple & multi candle ───────────────────────────────────────────────────────
float mid2 = (open[2] + close[2]) / 2

bool p26 = tDn3 and isBear[2] and isLong[2] and isSmall[1] and sepDn_1v2 and isBull and close > mid2 and close > bodyTop[1]
bool p27 = tUp3 and isBull[2] and isLong[2] and isSmall[1] and sepUp_1v2 and isBear and close < mid2 and close < bodyBot[1]
bool p28 = tDn3 and isBear[2] and isLong[2] and isDoji[1] and sepDn_1v2 and isBull and close > mid2 and close > bodyTop[1]
bool p29 = tUp3 and isBull[2] and isLong[2] and isDoji[1] and sepUp_1v2 and isBear and close < mid2 and close < bodyBot[1]
bool p30 = tDn3 and isBull and isBull[1] and isBull[2] and close > close[1] and close[1] > close[2] and body >= avgBody * 0.8 and body[1] >= avgBody * 0.8 and body[2] >= avgBody * 0.8 and open <= close[1] and open >= open[1] and open[1] <= close[2] and open[1] >= open[2] and upWick <= body * 0.5 and upWick[1] <= body[1] * 0.5
bool p31 = tUp3 and isBear and isBear[1] and isBear[2] and close < close[1] and close[1] < close[2] and body >= avgBody * 0.8 and body[1] >= avgBody * 0.8 and body[2] >= avgBody * 0.8 and open >= close[1] and open <= open[1] and open[1] >= close[2] and open[1] <= open[2] and dnWick <= body * 0.5 and dnWick[1] <= body[1] * 0.5
bool p32 = tDn3 and isBear[2] and isLong[2] and isBull[1] and bodyTop[1] <= bodyTop[2] and bodyBot[1] >= bodyBot[2] and isBull and close > high[1]
bool p33 = tUp3 and isBull[2] and isLong[2] and isBear[1] and bodyTop[1] <= bodyTop[2] and bodyBot[1] >= bodyBot[2] and isBear and close < low[1]
bool p34 = tDn3 and isBear[2] and isBull[1] and close[1] >= bodyTop[2] and open[1] <= bodyBot[2] and isBull and close > close[1]
bool p35 = tUp3 and isBull[2] and isBear[1] and open[1] >= bodyTop[2] and close[1] <= bodyBot[2] and isBear and close < close[1]
bool p36 = tUp5 and isBull[4] and isLong[4] and isSmall[3] and isSmall[2] and isSmall[1] and math.max(math.max(high[3], high[2]), high[1]) <= high[4] and math.min(math.min(low[3], low[2]), low[1]) >= low[4] and close[1] < close[3] and isBull and close > high[4]
bool p37 = tDn5 and isBear[4] and isLong[4] and isSmall[3] and isSmall[2] and isSmall[1] and math.max(math.max(high[3], high[2]), high[1]) <= high[4] and math.min(math.min(low[3], low[2]), low[1]) >= low[4] and close[1] > close[3] and isBear and close < low[4]
bool p38 = tDn5 and isBear[4] and isLong[4] and isBear[3] and sepDn_3v4 and close[2] < close[3] and close[1] < close[2] and isBull and isLong and close > bodyTop[3] and close < bodyBot[4]
bool p39 = tDn5 and isBear[4] and isBear[3] and isBear[2] and open[3] < open[4] and open[2] < open[3] and close[3] < close[4] and close[2] < close[3] and isBear[1] and upWick[1] >= body[1] * 0.5 and isBull and sepUpOpen and close > high[1]
bool p40 = tDn4 and isBear[3] and isMaru[3] and isBear[2] and isMaru[2] and close[2] < close[3] and isBear[1] and sepDn_1v2o and high[1] > close[2] and high[1] < open[2] and isBear and high > high[1] and low < low[1] and open > high[1]
bool p41 = tDn3 and isBear[2] and isLong[2] and isBear[1] and low[1] < low[2] and dnWick[1] >= body[1] * hamWick and bodyTop[1] <= bodyTop[2] and isBull and isSmall and close < close[1]
bool p42 = tDn3 and isDoji[2] and isDoji[1] and isDoji and sepTri
bool p43 = tUp3 and isBull and isBull[1] and isBull[2] and close > close[1] and close[1] > close[2] and body[1] < body[2] and body < body[1] and upWick >= body * 0.5 and upWick >= upWick[1] and isLong[2]
bool p44 = tUp3 and isBull[2] and isLong[2] and isBull[1] and isLong[1] and close[1] > close[2] and body <= body[1] * 0.35 and open >= close[1] - atr * 0.15 and notDoji
bool p45 = tUp3 and isBull[2] and isLong[2] and isBear[1] and sepUp_1v2 and isBear and open > open[1] and close < close[1] and close > close[2]

// ── register every candidate ──────────────────────────────────────────────────────────
f_check(0,  p01, hh1, ll1, 1)
f_check(1,  p02, hh1, ll1, -1)
f_check(2,  p03, hh1, ll1, 1)
f_check(3,  p04, hh1, ll1, -1)
f_check(4,  p05, hh1, ll1, 1)
f_check(5,  p06, hh1, ll1, -1)
f_check(6,  p07, hh1, ll1, 0)
f_check(7,  p08, hh1, ll1, 1)
f_check(8,  p09, hh1, ll1, -1)
f_check(9,  p10, hh1, ll1, 0)
f_check(10, p11, hh1, ll1, 0)
f_check(11, p12b, hh1, ll1, 1)
f_check(11, p12s, hh1, ll1, -1)
f_check(12, p13, hh2, ll2, 1)
f_check(13, p14, hh2, ll2, -1)
f_check(14, p15, hh2, ll2, 1)
f_check(15, p16, hh2, ll2, -1)
f_check(16, p17, hh2, ll2, 1)
f_check(17, p18, hh2, ll2, -1)
f_check(18, p19, hh2, ll2, 1)
f_check(19, p20, hh2, ll2, -1)
f_check(20, p21, hh2, ll2, 1)
f_check(21, p22, hh2, ll2, -1)
f_check(22, p23, hh2, ll2, 1)
f_check(23, p24, hh2, ll2, -1)
f_check(24, p25b, hh2, ll2, 1)
f_check(24, p25s, hh2, ll2, -1)
f_check(25, p26, hh3, ll3, 1)
f_check(26, p27, hh3, ll3, -1)
f_check(27, p28, hh3, ll3, 1)
f_check(28, p29, hh3, ll3, -1)
f_check(29, p30, hh3, ll3, 1)
f_check(30, p31, hh3, ll3, -1)
f_check(31, p32, hh3, ll3, 1)
f_check(32, p33, hh3, ll3, -1)
f_check(33, p34, hh3, ll3, 1)
f_check(34, p35, hh3, ll3, -1)
f_check(35, p36, hh5, ll5, 1)
f_check(36, p37, hh5, ll5, -1)
f_check(37, p38, hh5, ll5, 1)
f_check(38, p39, hh5, ll5, 1)
f_check(39, p40, hh4, ll4, 1)
f_check(40, p41, hh3, ll3, 1)
f_check(41, p42, hh3, ll3, 1)
f_check(42, p43, hh3, ll3, -1)
f_check(43, p44, hh3, ll3, -1)
f_check(44, p45, hh3, ll3, -1)

// ═══════════════════════════════════════════════════════════════════════════════════════
//  RENDER — abbreviation on the chart, full card in the tooltip
// ═══════════════════════════════════════════════════════════════════════════════════════
int    shiftBars = confirmOn ? 1 : 0
string tick      = " ✓"
string cross     = " ✗"

if barstate.isconfirmed and array.size(C_IDX) > 0
    int shown = 0
    for k = 0 to array.size(C_IDX) - 1
        if shown < maxPerBar
            int   idx = array.get(C_IDX, k)
            float phi = array.get(C_HI, k)
            float plo = array.get(C_LO, k)
            int   dir = array.get(C_DIR, k)
            int   len = array.get(P_LEN, idx)
            bool  bull = dir > 0
            bool  bear = dir < 0
            bool  neut = dir == 0

            // ── status from the confirmation candle ──
            bool broke   = bull ? close > phi : bear ? close < plo : (close > phi or close < plo)
            bool failed  = bull ? close < plo : bear ? close > phi : false
            string status = not confirmOn ? "FORMING" : broke ? "CONFIRMED" : failed ? "FAILED" : "PENDING"

            // ── the five cross-checks ──
            bool cTrend = bull ? dnRaw[len] : bear ? upRaw[len] : (dnRaw[len] or upRaw[len])
            bool cLoc   = bull ? atSupport : bear ? atResistance : (atSupport or atResistance)
            bool cRsi   = bull ? (bullDiv or rsiVal < rsiOS) : bear ? (bearDiv or rsiVal > rsiOB) : (rsiVal < rsiOS or rsiVal > rsiOB)
            bool cEma   = bull ? close > emaF : bear ? close < emaF : false
            bool cVol   = volHot
            int  score  = (cTrend ? 1 : 0) + (cLoc ? 1 : 0) + (cRsi ? 1 : 0) + (cEma ? 1 : 0) + (cVol ? 1 : 0)
            string grade = score >= 4 ? "STRONG" : score == 3 ? "MODERATE" : score >= 1 ? "WEAK" : "NONE"

            bool passStatus = showWhat == "Everything (incl. failed)" ? true : showWhat == "Confirmed only" ? (status == "CONFIRMED" or status == "FORMING") : status != "FAILED"

            if passStatus and score >= minScore
                string code = array.get(P_CODE, idx)
                string name = array.get(P_NAME, idx)
                string role = array.get(P_ROLE, idx)
                int    prio = array.get(P_PRIO, idx)
                int    rel  = array.get(P_REL, idx)
                int    cat  = array.get(P_CAT, idx)
                int    num  = array.get(P_NUM, idx)
                string dirTx = bull ? "Bullish" : bear ? "Bearish" : "Neutral"
                string prioTx = prio == 1 ? "Must" : prio == 2 ? "Important" : "Rare"
                string catTx = cat == 1 ? "Single Candle" : cat == 2 ? "Double Candle" : "Triple & Multi"

                string head = code + "\n" + dirTx + " " + name + "\nStatus: " + status + "\n\n"
                string chk = "Pattern: Valid ✓\n" + "Trend: " + (bull ? "Downtrend" : bear ? "Uptrend" : "Trending") + (cTrend ? tick : cross) + "\n" + "Location: " + (bull ? "Support" : bear ? "Resistance" : "Key level") + (cLoc ? tick : cross) + "\n" + "RSI: " + (bull ? (bullDiv ? "Bullish divergence" : "Oversold") : bear ? (bearDiv ? "Bearish divergence" : "Overbought") : "Extreme") + " (" + str.tostring(rsiVal, "#.#") + ")" + (cRsi ? tick : cross) + "\n" + "EMA: " + (close > emaF ? "Above " : "Below ") + str.tostring(emaFast) + " EMA" + (emaReclaim ? " (just reclaimed)" : emaLoss ? " (just lost)" : "") + (cEma ? tick : cross) + "\n" + "Volume: " + (volOn ? "Above average" : "No volume data") + (cVol ? tick : cross) + "\n\n" + "Validation: " + grade + " (" + str.tostring(score) + "/5)\n"
                string card = "──────────────────────────────\n" + "#" + str.tostring(num) + " · " + catTx + " · " + role + "\n" + "Structure: " + str.tostring(len) + "-candle · " + dirTx + " · " + prioTx + "\n" + "Ideal time frame: " + prettyTF(array.get(P_TF, idx)) + "   (chart: " + tfCode + ")\n" + "Reliability: " + str.tostring(rel) + "%\n" + "Pattern high: " + str.tostring(phi, format.mintick) + "   Pattern low: " + str.tostring(plo, format.mintick) + "\n" + "──────────────────────────────\n"
                string tip = head + chk + card + array.get(P_INFO, idx)

                color base = bull ? color.rgb(38, 166, 154) : bear ? color.rgb(239, 83, 80) : color.rgb(120, 123, 134)
                int   trans = status == "CONFIRMED" ? 5 : status == "PENDING" or status == "FORMING" ? 45 : 70
                float yBase = bull ? low[shiftBars] - atr * labelOff : bear ? high[shiftBars] + atr * labelOff : high[shiftBars] + atr * labelOff
                float y = bull ? yBase - atr * 0.55 * shown : yBase + atr * 0.55 * shown
                string txt = showGlyph ? code + (status == "CONFIRMED" ? "✓" : status == "FAILED" ? "✗" : "·") : code

                label.new(bar_index - shiftBars, y, txt, xloc = xloc.bar_index, yloc = yloc.price, color = color.new(base, trans), style = bull ? label.style_label_up : label.style_label_down, textcolor = color.white, size = labelSize == "Tiny" ? size.tiny : labelSize == "Small" ? size.small : size.normal, tooltip = tip)

                if alertsOn
                    alert(code + " · " + name + " · " + status + " · " + grade + " (" + str.tostring(score) + "/5) · " + syminfo.ticker + " " + timeframe.period, alert.freq_once_per_bar_close)
                shown := shown + 1

// ═══════════════════════════════════════════════════════════════════════════════════════
//  DASHBOARD
// ═══════════════════════════════════════════════════════════════════════════════════════
var table dash = table.new(dashPos == "Top Right" ? position.top_right : dashPos == "Top Left" ? position.top_left : dashPos == "Bottom Right" ? position.bottom_right : position.bottom_left, 2, 8, border_width = 1)

if showDash and barstate.islast
    int active = 0
    if array.size(P_EN) > 0
        for i = 0 to array.size(P_EN) - 1
            if array.get(P_EN, i)
                active := active + 1
    string regime = upRaw ? "Uptrend" : dnRaw ? "Downtrend" : "Range / mixed"
    table.cell(dash, 0, 0, "CS45 ENGINE", text_color = color.white, bgcolor = color.new(color.blue, 20), text_size = size.small)
    table.cell(dash, 1, 0, tfCode, text_color = color.white, bgcolor = color.new(color.blue, 20), text_size = size.small)
    table.cell(dash, 0, 1, "Patterns armed", text_size = size.tiny)
    table.cell(dash, 1, 1, str.tostring(active) + " / " + str.tostring(array.size(P_CODE)), text_size = size.tiny)
    table.cell(dash, 0, 2, "Trend", text_size = size.tiny)
    table.cell(dash, 1, 2, regime, text_size = size.tiny, text_color = upRaw ? color.teal : dnRaw ? color.red : color.gray)
    table.cell(dash, 0, 3, "RSI(" + str.tostring(rsiLen) + ")", text_size = size.tiny)
    table.cell(dash, 1, 3, str.tostring(rsiVal, "#.#") + (bullDiv ? " ▲div" : bearDiv ? " ▼div" : ""), text_size = size.tiny)
    table.cell(dash, 0, 4, "Price vs " + str.tostring(emaFast) + " EMA", text_size = size.tiny)
    table.cell(dash, 1, 4, close > emaF ? "Above" : "Below", text_size = size.tiny)
    table.cell(dash, 0, 5, "Volume", text_size = size.tiny)
    table.cell(dash, 1, 5, not volOn ? "n/a" : volHot ? "Above avg" : "Normal", text_size = size.tiny)
    table.cell(dash, 0, 6, "Location", text_size = size.tiny)
    table.cell(dash, 1, 6, atSupport ? "At support" : atResistance ? "At resistance" : "Mid-range", text_size = size.tiny)
    table.cell(dash, 0, 7, "Filter", text_size = size.tiny)
    table.cell(dash, 1, 7, fDir + (tfMode == "Strict — ideal time frames only" ? " · TF strict" : tfMode == "Ideal ± 1 step" ? " · TF ±1" : " · TF off"), text_size = size.tiny)
