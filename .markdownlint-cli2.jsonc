{
  // Markdown files to lint across the specification library.
  "globs": ["**/*.md"],
  "ignores": ["node_modules"],
  "config": {
    "default": true,
    // Specs and process docs use prose with long, wrapped lines and tables.
    "MD013": false,
    // Allow inline HTML (occasionally useful in tables/diagrams).
    "MD033": false,
    // Ordered lists may restart within nested sections.
    "MD029": { "style": "one_or_ordered" }
  }
}
