//@version=6
// ─────────────────────────────────────────────────────────────────────────────
// CANDLESTICK MASTER — 45 PATTERNS  (Batch 1: patterns 01–10 + BEC preview)
//
// Educational pattern-recognition indicator. Detects candlestick patterns ONLY
// (no trade signals, no strategy). Works on the TradingView free plan.
//
// HOW IT WORKS
//   • Anatomy engine     : OHLC-based candle measurements, ATR-scaled.
//   • Context engine     : prior trend (EMA20/50 + slope) and pivot S/R zones.
//   • Confirmation engine: confirmation candle, RSI (+divergence), volume,
//                          20 EMA reclaim — each toggleable, scored into
//                          Validation = WEAK / MODERATE / STRONG.
//   • Timeframe gating   : each pattern lists its ideal TradingView timeframes
//                          ("1","2","3","5","15","30","60","120","240","D","W")
//                          and is only evaluated/drawn on those charts.
//   • Display            : abbreviation-only label; hover (desktop) or
//                          press-and-hold (mobile) shows the full dynamic
//                          checklist tooltip.
//
// EXTENDING WITH BATCH 2+ : add a shape condition in the DETECTION section and
// one fire() call — the engines handle everything else. Ideal timeframes are
// the "60,240,D"-style strings in each fire() call; edit them freely.
//
// NOTE: forex volume on TradingView is TICK volume, not real traded volume.
// ─────────────────────────────────────────────────────────────────────────────
indicator("Candlestick Master — 45 Patterns", "CandleMaster45", overlay = true, max_labels_count = 500)

// ═════════════════════════════════ INPUTS ══════════════════════════════════
grpCat = "Filters — Category"
showBullRev = input.bool(true,  "Bullish reversal patterns",        group = grpCat)
showBearRev = input.bool(true,  "Bearish reversal patterns",        group = grpCat)
showCont    = input.bool(true,  "Continuation / momentum patterns", group = grpCat)
showInd     = input.bool(true,  "Indecision / exhaustion patterns", group = grpCat)

grpTier = "Filters — Priority Tier"
tierMust = input.bool(true,  "Must",      group = grpTier)
tierImp  = input.bool(true,  "Important", group = grpTier)
tierRare = input.bool(false, "Rare",      group = grpTier)

grpStr = "Filters — Structure"
structSingle = input.bool(true, "Single candle",         group = grpStr)
structDouble = input.bool(true, "Double candle",         group = grpStr)
structTriple = input.bool(true, "Triple & multi candle", group = grpStr)

grpTf = "Timeframe Gating"
ignoreTf = input.bool(false, "Ignore timeframe filter (show everywhere)", group = grpTf, tooltip = "For testing only. When OFF, each pattern appears only on its ideal chart timeframes.")

grpConf = "Confirmation Engine"
confirmedOnly = input.bool(false, "Show only confirmed patterns",  group = grpConf, tooltip = "Draw a pattern only after the next candle closes beyond the pattern high/low.")
confWindow    = input.int(3,     "Confirmation window (bars)",     group = grpConf, minval = 1, maxval = 10, tooltip = "Bars allowed for the confirmation close before the pattern expires.")
useLoc        = input.bool(true, "Check: support/resistance zone", group = grpConf)
useRSI        = input.bool(true, "Check: RSI level / divergence",  group = grpConf)
useEMA        = input.bool(true, "Check: 20 EMA reclaim/loss",     group = grpConf)
useVol        = input.bool(true, "Check: volume spike (tick vol)", group = grpConf)
volMult       = input.float(1.2, "Volume spike multiplier",        group = grpConf, minval = 0.5, step = 0.1)
rsiOS         = input.int(35,    "RSI oversold level",             group = grpConf, minval = 1,  maxval = 50)
rsiOB         = input.int(65,    "RSI overbought level",           group = grpConf, minval = 50, maxval = 99)

grpCtx = "Context Engine"
trendLb   = input.int(5,     "Trend slope lookback (bars)",      group = grpCtx, minval = 1)
pivLen    = input.int(5,     "Pivot length (S/R + divergence)",  group = grpCtx, minval = 2)
zoneMult  = input.float(0.5, "S/R zone width (x ATR)",           group = grpCtx, minval = 0.1, step = 0.1)
divWindow = input.int(12,    "RSI divergence valid for (bars)",  group = grpCtx, minval = 1)

grpP1 = "Patterns — Single Candle (01–10)"
p01 = input.bool(true, "01 Hammer (HAM)",            group = grpP1)
p02 = input.bool(true, "02 Hanging Man (HGM)",       group = grpP1)
p03 = input.bool(true, "03 Inverted Hammer (IH)",    group = grpP1)
p04 = input.bool(true, "04 Shooting Star (SST)",     group = grpP1)
p05 = input.bool(true, "05 Bullish Marubozu (BUM)",  group = grpP1)
p06 = input.bool(true, "06 Bearish Marubozu (BEM)",  group = grpP1)
p07 = input.bool(true, "07 Spinning Top (SPT)",      group = grpP1)
p08 = input.bool(true, "08 Standard Doji (DOJ)",     group = grpP1)
p09 = input.bool(true, "09 Long-Legged Doji (LLD)",  group = grpP1)
p10 = input.bool(true, "10 Dragonfly Doji (DFD)",    group = grpP1)

grpP2 = "Patterns — Preview (awaiting your data)"
pGSD = input.bool(true, "Gravestone Doji (GSD)",     group = grpP2)
p13  = input.bool(true, "Bullish Engulfing (BEC)",   group = grpP2)

// ════════════════════════════ ANATOMY ENGINE ═══════════════════════════════
atrV    = ta.atr(14)
body    = math.abs(close - open)
rng     = high - low
upW     = high - math.max(close, open)
loW     = math.min(close, open) - low
bullC   = close > open
bearC   = close < open
bodyPct = rng > 0 ? body / rng : 0.0

minRange  = rng >= atrV * 0.5           // ignore micro/noise candles
longBody  = body >= atrV * 0.8
smallBody = body <= atrV * 0.35

// Gaps and previous-candle midpoint relations (used by later batches too)
gapUp             = open > high[1]
gapDown           = open < low[1]
bodyGapUp         = open > math.max(open[1], close[1])
bodyGapDown       = open < math.min(open[1], close[1])
prevBodyMid       = (open[1] + close[1]) / 2
closeAbovePrevMid = close > prevBodyMid
closeBelowPrevMid = close < prevBodyMid

// ════════════════════════════ CONTEXT ENGINE ═══════════════════════════════
emaFast = ta.ema(close, 20)
emaSlow = ta.ema(close, 50)
upTrend   = emaFast > emaSlow and emaSlow > emaSlow[trendLb]
downTrend = emaFast < emaSlow and emaSlow < emaSlow[trendLb]

// Pivot-based support / resistance zones
pl = ta.pivotlow(low, pivLen, pivLen)
ph = ta.pivothigh(high, pivLen, pivLen)
var supLevels = array.new<float>()
var resLevels = array.new<float>()
if not na(pl)
    supLevels.push(pl)
    if supLevels.size() > 12
        supLevels.shift()
if not na(ph)
    resLevels.push(ph)
    if resLevels.size() > 12
        resLevels.shift()

nearLevel(array<float> lvls, float price, float tol) =>
    hit = false
    if lvls.size() > 0
        for i = 0 to lvls.size() - 1
            if math.abs(price - lvls.get(i)) <= tol
                hit := true
    hit

zoneTol = atrV * zoneMult
nearSup = nearLevel(supLevels, low, zoneTol)
nearRes = nearLevel(resLevels, high, zoneTol)

// ═════════════════════════ CONFIRMATION ENGINE ═════════════════════════════
rsiVal = ta.rsi(close, 14)
volSma = ta.sma(volume, 20)
volOkG = not na(volume) and not na(volSma) and volume > volSma * volMult
volNa  = na(volume) or na(volSma)

// RSI divergence via price/RSI pivots
var float lastPL  = na
var float lastPLr = na
var float lastPH  = na
var float lastPHr = na
var int bullDivBar = na
var int bearDivBar = na
if not na(pl)
    if not na(lastPL) and pl < lastPL and rsiVal[pivLen] > lastPLr
        bullDivBar := bar_index
    lastPL  := pl
    lastPLr := rsiVal[pivLen]
if not na(ph)
    if not na(lastPH) and ph > lastPH and rsiVal[pivLen] < lastPHr
        bearDivBar := bar_index
    lastPH  := ph
    lastPHr := rsiVal[pivLen]
bullDivActive = not na(bullDivBar) and bar_index - bullDivBar <= divWindow
bearDivActive = not na(bearDivBar) and bar_index - bearDivBar <= divWindow

// ═══════════════════ PATTERN INSTANCE / LABEL SYSTEM ═══════════════════════
colBull = color.new(#089981, 0)
colBear = color.new(#f23645, 0)
colNeut = color.new(#787b86, 0)
SEP = "─────────────"

type PatternInst
    label  lb = na
    int    barIdx
    float  patHigh
    float  patLow
    int    dir       // 1 bullish, -1 bearish, 0 neutral/info
    int    state     // 0 detected, 1 confirmed, 2 failed, 3 info, 4 expired
    string abbr
    string pname
    string bodyTxt
    color  colMain

method tipText(PatternInst this) =>
    st = switch this.state
        0 => "DETECTED — AWAITING CONFIRMATION"
        1 => "CONFIRMED ✓"
        2 => "FAILED ✗ (invalidation level hit)"
        3 => "NEUTRAL — INFORMATIONAL"
        => "EXPIRED — no confirmation in window"
    this.abbr + "\n" + this.pname + "\nStatus: " + st + "\n" + this.bodyTxt

method draw(PatternInst this) =>
    isBear = this.dir == -1
    this.lb := label.new(this.barIdx, isBear ? this.patHigh : this.patLow, this.abbr, xloc = xloc.bar_index, yloc = yloc.price, color = this.colMain, style = isBear ? label.style_label_down : label.style_label_up, textcolor = color.white, size = size.small, tooltip = this.tipText())

var insts = array.new<PatternInst>()

// ──────────────────────────── fire() — registry ─────────────────────────────
// Runs shared filters + confirmation checks, builds the tooltip, and draws
// the abbreviation label. Every pattern goes through this single function.
//   cat: "BR" bull reversal · "SR" bear reversal · "CT" continuation · "IN" indecision
//   tier: "M" Must · "I" Important · "R" Rare
fire(bool patOn, int structN, string tier, string cat, int dir, string tfList, string abbr, string pname, string trendTxt, string desc, string sltp, string reli, string tfHuman, float pHigh, float pLow) =>
    catOn    = cat == "BR" ? showBullRev : cat == "SR" ? showBearRev : cat == "CT" ? showCont : showInd
    tierOn   = tier == "M" ? tierMust : tier == "I" ? tierImp : tierRare
    structOn = structN == 1 ? structSingle : structN == 2 ? structDouble : structTriple
    tfOn     = ignoreTf or tfList == "ALL" or str.contains("," + tfList + ",", "," + timeframe.period + ",")
    if patOn and catOn and tierOn and structOn and tfOn
        // per-direction confirmation checks
        locOk = dir == 1 ? nearSup : dir == -1 ? nearRes : nearSup or nearRes
        rsiOk = dir == 1 ? bullDivActive or rsiVal < rsiOS : dir == -1 ? bearDivActive or rsiVal > rsiOB : bullDivActive or bearDivActive or rsiVal < rsiOS or rsiVal > rsiOB
        emaOk = dir == 1 ? close > emaFast : dir == -1 ? close < emaFast : false
        locTxt = dir >= 0 and locOk and nearSup ? "Location: Support zone ✓" : dir == -1 and locOk ? "Location: Resistance zone ✓" : locOk ? "Location: Resistance zone ✓" : "Location: No key zone nearby ✗"
        rsiTxt = dir == 1 ? (bullDivActive ? "RSI: Bullish divergence ✓" : rsiVal < rsiOS ? "RSI: Oversold ✓" : "RSI: Neutral ✗") : dir == -1 ? (bearDivActive ? "RSI: Bearish divergence ✓" : rsiVal > rsiOB ? "RSI: Overbought ✓" : "RSI: Neutral ✗") : (rsiOk ? "RSI: At extreme / divergence ✓" : "RSI: " + str.tostring(rsiVal, "#.#") + " neutral ✗")
        emaTxt = dir == 1 ? (emaOk ? "EMA: Reclaiming 20 EMA ✓" : "EMA: Below 20 EMA ✗") : dir == -1 ? (emaOk ? "EMA: Losing 20 EMA ✓" : "EMA: Above 20 EMA ✗") : "EMA: n/a for neutral pattern"
        volTxt = volNa ? "Volume: n/a on this feed" : volOkG ? "Volume: Above average ✓ (tick vol)" : "Volume: Below average ✗ (tick vol)"
        // score enabled checks -> validation
        nChecks = (useLoc ? 1 : 0) + (useRSI ? 1 : 0) + (dir != 0 and useEMA ? 1 : 0) + (useVol and not volNa ? 1 : 0)
        nPassed = (useLoc and locOk ? 1 : 0) + (useRSI and rsiOk ? 1 : 0) + (dir != 0 and useEMA and emaOk ? 1 : 0) + (useVol and not volNa and volOkG ? 1 : 0)
        vali = nChecks == 0 ? "N/A (checks disabled)" : nPassed * 4 >= nChecks * 3 ? "STRONG" : nPassed * 2 >= nChecks ? "MODERATE" : "WEAK"
        checks = "Pattern: Valid ✓\n" + trendTxt + (useLoc ? "\n" + locTxt : "") + (useRSI ? "\n" + rsiTxt : "") + (useEMA ? "\n" + emaTxt : "") + (useVol ? "\n" + volTxt : "")
        bodyTxt = SEP + "\n" + checks + "\n" + SEP + "\nValidation: " + vali + "\n" + SEP + "\n" + desc + "\n" + sltp + "\nReliability: " + reli + " · Ideal TF: " + tfHuman
        inst = PatternInst.new(barIdx = bar_index, patHigh = pHigh, patLow = pLow, dir = dir, state = dir == 0 ? 3 : 0, abbr = abbr, pname = pname, bodyTxt = bodyTxt, colMain = dir == 1 ? colBull : dir == -1 ? colBear : colNeut)
        if not confirmedOnly or dir == 0
            inst.draw()
        insts.push(inst)
        if insts.size() > 450
            old = insts.shift()
            if not na(old.lb)
                label.delete(old.lb)

// ═════════════════════════ DETECTION — BATCH 1 ═════════════════════════════
// Shape conditions (pure OHLC anatomy — candle color never defines validity
// except where the pattern definition itself fixes it, e.g. marubozu/engulfing)
hammerShape  = minRange and body > rng * 0.10 and loW >= 2 * body and upW <= rng * 0.15
invHamShape  = minRange and body > rng * 0.10 and upW >= 2 * body and loW <= rng * 0.15
maruBullShp  = bullC and body >= atrV * 0.8 and body >= rng * 0.9
maruBearShp  = bearC and body >= atrV * 0.8 and body >= rng * 0.9
dojiShape    = rng > 0 and body <= rng * 0.10
dragonShape  = dojiShape and minRange and loW >= rng * 0.6 and upW <= rng * 0.15
graveShape   = dojiShape and minRange and upW >= rng * 0.6 and loW <= rng * 0.15
longLegShape = dojiShape and not dragonShape and not graveShape and rng >= atrV * 1.1 and upW >= rng * 0.35 and loW >= rng * 0.35
plainDoji    = dojiShape and not dragonShape and not graveShape and not longLegShape
spinTopShape = rng > 0 and not dojiShape and bodyPct <= 0.30 and upW >= body and loW >= body
becShape     = bearC[1] and bullC and open <= close[1] and close >= open[1] and body > body[1] and body[1] > 0

// Neutral-pattern trend context text
ctxTxt = "Trend: " + (upTrend[1] ? "Uptrend" : downTrend[1] ? "Downtrend" : "Sideways") + " (context)"

if barstate.isconfirmed
    // 01 HAMMER — bullish reversal after downtrend · Must · H1 H4 D1
    if hammerShape and downTrend[1]
        fire(p01, 1, "M", "BR", 1, "60,240,D", "HAM", "Hammer", "Trend: Downtrend ✓", "After a downtrend: small body at the top of the range, lower shadow ≥ 2× body — sellers pushed deep but buyers slammed price back near the open. Body color does not define validity.", "SL: a few ticks below the hammer's lower-shadow tip  |  TP: TP1 nearest resistance, TP2 previous swing high (min 1:2 RR)", "★ Good (72%)", "H1 · H4 · D1", high, low)
    // 02 HANGING MAN — bearish reversal after mature uptrend · Important · H1 H4 D1
    if hammerShape and upTrend[1]
        fire(p02, 1, "I", "SR", -1, "60,240,D", "HGM", "Hanging Man", "Trend: Uptrend ✓", "Hammer shape at the peak of an uptrend — the long lower shadow shows sellers can finally push price far down. Trend location, not color, is what matters.", "SL: above the hanging-man high  |  TP: nearest swing low / next support; trail as price falls", "★ Fair (62%)", "H1 · H4 · D1", high, low)
    // 03 INVERTED HAMMER — bullish reversal after downtrend · Must · H1 H4 D1
    if invHamShape and downTrend[1]
        fire(p03, 1, "M", "BR", 1, "60,240,D", "IH", "Inverted Hammer", "Trend: Downtrend ✓", "Small body at the bottom of the range, upper shadow ≥ 2× body, after a downtrend — the failed push up marks buyers entering the market. Green or red both valid.", "SL: below the inverted-hammer low  |  TP: nearest resistance then previous swing high; secure partials at TP1", "★ Fair (65%)", "H1 · H4 · D1", high, low)
    // 04 SHOOTING STAR — bearish reversal after uptrend · Must · H1 H4 D1
    if invHamShape and upTrend[1]
        fire(p04, 1, "M", "SR", -1, "60,240,D", "SST", "Shooting Star", "Trend: Uptrend ✓", "Small body at the bottom, upper shadow ≥ 2× body, after an uptrend — price was pushed high then slammed down by sellers; classic rejection at the top.", "SL: a few ticks above the upper-shadow tip  |  TP: nearest support or last swing low; keep partials for the swing", "★ Good (68%)", "H1 · H4 · D1", high, low)
    // 05 BULLISH MARUBOZU — momentum / continuation · Must · M15 H1 D1
    if maruBullShp
        fire(p05, 1, "M", "CT", 1, "15,60,D", "BUM", "Bullish Marubozu", ctxTxt, "Long green body opening at the low and closing at the high (no shadows) — buyers in full control throughout; decisive momentum. Must be green: close > open is its definition.", "SL: below the marubozu low (or body midpoint, tighter)  |  TP: 1x–1.5x body expansion or next major resistance", "★ High (74%)", "M15 · H1 · D1", high, low)
    // 06 BEARISH MARUBOZU — momentum / continuation · Must · M15 H1 D1
    if maruBearShp
        fire(p06, 1, "M", "CT", -1, "15,60,D", "BEM", "Bearish Marubozu", ctxTxt, "Long red body opening at the high and closing at the low (no shadows) — sellers control the entire journey; decisive bearish momentum. Must be red: close < open is its definition.", "SL: above the marubozu high (or body midpoint, tighter)  |  TP: 1x–1.5x body expansion or next major support", "★ High (74%)", "M15 · H1 · D1", high, low)
    // 07 SPINNING TOP — indecision alarm · Important · All TFs
    if spinTopShape and minRange
        fire(p07, 1, "I", "IN", 0, "ALL", "SPT", "Spinning Top", ctxTxt, "Tiny body mid-range with roughly equal shadows — buyers and sellers fight to a draw. An indecision alarm, not a standalone entry signal.", "SL: opposite side of the breakout direction  |  TP: follows the breakout to the next S/R level", "★ Low (55%)", "All TFs", high, low)
    // 08 STANDARD DOJI — indecision marker · Important · H1 H4 D1
    if plainDoji and minRange
        fire(p08, 1, "I", "IN", 0, "60,240,D", "DOJ", "Standard Doji", ctxTxt, "Open ≈ close so the body is a thin line — maximum indecision. After a long trend it is often the first crack in the ruling side's dominance. A warning, not an entry signal.", "SL: doji shadow tip opposite the entry  |  TP: nearest structure level (conservative targets)", "★ Low (58%)", "H1 · H4 · D1", high, low)
    // 09 LONG-LEGGED DOJI — volatility indecision · Important · H4 D1
    if longLegShape
        fire(p09, 1, "I", "IN", 0, "240,D", "LLD", "Long-Legged Doji", ctxTxt, "Open ≈ close but price traveled very far up AND down — violent churn ending in a draw; major confusion, often at important turning points.", "SL: opposite side of the doji range  |  TP: at least the doji-range width projected from the breakout", "★ Fair (60%)", "H4 · D1", high, low)
    // 10 DRAGONFLY DOJI — bullish reversal after downtrend · Important · H1 H4 D1
    if dragonShape and downTrend[1]
        fire(p10, 1, "I", "BR", 1, "60,240,D", "DFD", "Dragonfly Doji", "Trend: Downtrend ✓", "Open, close and high at nearly the same level with a very long lower shadow — sellers pressed hard but buyers returned it all; strong downside rejection.", "SL: a few ticks below the lower-shadow tip  |  TP: nearest resistance; trail the stop to maximize the swing", "★ Fair (66%)", "H1 · H4 · D1", high, low)
    // GRAVESTONE DOJI (preview — awaiting your data) — bearish reversal after uptrend
    if graveShape and upTrend[1]
        fire(pGSD, 1, "I", "SR", -1, "60,240,D", "GSD", "Gravestone Doji", "Trend: Uptrend ✓", "Doji with a long upper shadow and open/close/low at nearly the same level — buyers pushed high but sellers erased it all.", "SL: above the gravestone high  |  TP: nearest support", "★ Good (67%)", "H1 · H4 · D1", high, low)
    // BULLISH ENGULFING (preview from batch 2) — bullish reversal · Must · H1 H4 D1
    if becShape and downTrend[2]
        fire(p13, 2, "M", "BR", 1, "60,240,D", "BEC", "Bullish Engulfing", "Trend: Downtrend ✓", "After a downtrend, a small bearish candle's body is fully engulfed by a large bullish candle — total, instant transfer of control to buyers.", "SL: below the engulfing candle low  |  TP: nearest resistance then swing high; often starts long moves — consider trailing", "★ High (78%)", "H1 · H4 · D1", math.max(high, high[1]), math.min(low, low[1]))

// ═══════════════ STATE UPDATES: CONFIRM / FAIL / EXPIRE ════════════════════
if barstate.isconfirmed and insts.size() > 0
    for i = 0 to insts.size() - 1
        inst = insts.get(i)
        if inst.state == 0 and bar_index > inst.barIdx
            newState = 0
            if inst.dir == 1
                newState := close > inst.patHigh ? 1 : close < inst.patLow ? 2 : 0
            else if inst.dir == -1
                newState := close < inst.patLow ? 1 : close > inst.patHigh ? 2 : 0
            if newState == 0 and bar_index - inst.barIdx >= confWindow
                newState := 4
            if newState != 0
                inst.state := newState
                if na(inst.lb) and newState == 1
                    inst.draw()
                if not na(inst.lb)
                    label.set_tooltip(inst.lb, inst.tipText())
                    if newState == 2 or newState == 4
                        label.set_color(inst.lb, color.new(inst.colMain, 75))
